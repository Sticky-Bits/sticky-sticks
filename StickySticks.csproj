<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Title>Sticky Sticks</Title>
    <Product>Sticky Sticks</Product>
    <AssemblyName>StickySticks</AssemblyName>
    <Version>0.3</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <InformationalVersion>0.3</InformationalVersion>
    <RootNamespace>StickySticks</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <None Update="LICENSE;THIRD_PARTY_NOTICES.md;licenses\*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Remove="analysis\**\*.cs" />
    <None Update="native\SDL3.dll" Link="SDL3.dll" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    <None Update="native\libusb-1.0.dll" Link="libusb-1.0.dll" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    <None Update="licenses\libusb-1.0.30-source.tar.bz2" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="native\gamecontrollerdb.txt" Link="gamecontrollerdb.txt" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
